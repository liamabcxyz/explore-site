{
  "type": "line",
  "source": "transportation",
  "source-layer": "segment",
  "minzoom": 10,
  "filter": [
    "==",
    ["get", "subtype"],
    "water"
  ],
  "paint": {
    "line-color": "$transportation.water.color.ferry",
    "line-width": [
      "interpolate",
      ["exponential", 1.5],
      ["zoom"],
      10, 0.8,
      12, 1.4,
      16, 2.5,
      20, 4.5
    ],
    "line-dasharray": [3, 3],
    "line-opacity": 0.85
  },
  "layout": {
    "line-cap": "butt",
    "line-join": "round"
  },
  "metadata": {
    "overture:theme": "transportation",
    "overture:type": "segment",
    "overture:group": "transportation-water",
    "overture:selectable": true,
    "overture:item": "waterway"
  }
}
